{
  "name": "is-in-subnet",
  "version": "4.0.1",
  "description": "Check if an IPv4 or IPv6 address is contained in the given CIDR subnet",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "clean": "del-cli dist coverage browser",
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "contributors && npm run clean && npm run build",
    "prettier": "prettier --write \"{src,test}/**/*.?(ts|json)\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=10.23.0"
  },
  "repository": "natesilva/is-in-subnet",
  "keywords": [
    "ip",
    "address",
    "ipv4",
    "ipv6",
    "cidr",
    "networking"
  ],
  "license": "MIT",
  "author": "Nate Silva <nate@natesilva.com>",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@tsconfig/node-lts": "^22.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.1.2",
    "del-cli": "^6.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "@mocha/contributors": {
    "exclude": [
      "Nate Silva <natesilva@users.noreply.github.com>"
    ]
  },
  "contributors": [
    "Chris Walker <chris@thechriswalker.net>",
    "dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>",
    "Nate Silva <nate@natesilva.com>",
    "Spencer Wilson <spencer.wilson@optimizely.com>"
  ],
  "volta": {
    "node": "22.15.0"
  }
}