{
  "name": "@natesilva/is-in-subnet",
  "version": "5.0.0-beta.4",
  "description": "Check if an IPv4 or IPv6 address is contained in the given CIDR subnet",
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.global.js"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "clean": "del-cli dist coverage",
    "build": "tsup",
    "prepublishOnly": "npm run clean && npm run build",
    "prettier": "prettier --write \"{src,test}/**/*.?(ts|json)\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --watch --ui",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "docs": "typedoc"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natesilva/is-in-subnet.git"
  },
  "keywords": [
    "ip",
    "address",
    "ipv4",
    "ipv6",
    "cidr",
    "networking"
  ],
  "license": "MIT",
  "author": "Nate Silva <nate@natesilva.com>",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@tsconfig/node-ts": "^23.6.1",
    "@tsconfig/node20": "^20.1.5",
    "@types/node": "^20.17.31",
    "@vitest/coverage-v8": "^3.1.2",
    "@vitest/ui": "^3.1.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "contributors": [
    "Chris Walker <chris@thechriswalker.net>",
    "dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>",
    "Nate Silva <nate@natesilva.com>",
    "Spencer Wilson <spencer.wilson@optimizely.com>"
  ],
  "volta": {
    "node": "22.16.0"
  }
}
